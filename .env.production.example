# MoonBite Partners — PRODUCTION environment template.
# Copy to a secret store (GitHub Actions secrets/vars, server .env, or a vault).
# NEVER commit real values. Generate the random secrets with:
#   sh scripts/generate-secrets.sh
#
# The API validates these on boot (apps/api/src/config/env.validation.ts) and
# REFUSES TO START if a required secret is missing, too short, or a known
# placeholder. /ready reports go/no-go for accepting live traffic + funds.

NODE_ENV=production

# --- URLs ---
WEB_BASE_URL=https://app.yourdomain.com          # the web app (verify/reset links)
PUBLIC_BASE_URL=https://api.yourdomain.com        # this API (signed download links)
CORS_ORIGINS=https://app.yourdomain.com
TRUST_PROXY=1                                     # behind a reverse proxy/LB

# --- Secrets (generate; do not reuse dev values) ---
JWT_SECRET=                                        # openssl rand -hex 32
DOWNLOAD_URL_SECRET=                               # openssl rand -hex 32
POSTGRES_PASSWORD=                                 # openssl rand -hex 32

# --- Datastores (point at managed services for a real deploy) ---
DATABASE_URL=postgresql://moonbite:__PW__@postgres:5432/moonbite?schema=public
REDIS_URL=redis://redis:6379

# --- Transactional email (required: verify/reset/receipts) ---
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587                                      # 465 = implicit TLS
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MoonBite <no-reply@yourdomain.com>

# --- Signed downloads ---
STORAGE_BASE_URL=https://cdn.yourdomain.com        # objects live at STORAGE_BASE_URL/<objectKey>

# --- MBITE node + REAL chain params (⛔ confirm before accepting funds) ---
MBITE_RPC_URL=http://mbite-node:9332
MBITE_RPC_USER=
MBITE_RPC_PASSWORD=
MBITE_ZMQ_RAWTX=tcp://mbite-node:28332
MBITE_ZMQ_RAWBLOCK=tcp://mbite-node:28333
# From MBITE's real chainparams — verify a derived address on the explorer:
MBITE_BECH32_HRP=
MBITE_PUBKEYHASH=
MBITE_SCRIPTHASH=
MBITE_WIF=
MBITE_BIP32_PUBLIC=
MBITE_BIP32_PRIVATE=
MBITE_ADDRESS_TYPE=p2wpkh                          # p2pkh if MBITE is legacy-only
