# ─────────────────────────────────────────────────────────────
# MoonBite Partners — environment template. Copy to .env and fill.
# NEVER commit the real .env. No private keys live here (see §8 of PLAN.md).
# ─────────────────────────────────────────────────────────────

# --- API server ---
API_PORT=4000
NODE_ENV=development
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# --- Database (Postgres) ---
DATABASE_URL=postgresql://moonbite:moonbite@localhost:5432/moonbite?schema=public

# --- Redis (invoice state, queues, rate limits) ---
REDIS_URL=redis://localhost:6379

# --- MBITE full node JSON-RPC ---
# Point this at your own node (see docker-compose.yml / PLAN.md Phase 0).
MBITE_RPC_URL=http://127.0.0.1:9332
MBITE_RPC_USER=moonbite
MBITE_RPC_PASSWORD=change-me
# ZMQ endpoints for push notifications (PRIMARY payment trigger — the node must
# be started with -zmqpubrawtx / -zmqpubrawblock). Leave blank to fall back to
# the backstop poller only.
MBITE_ZMQ_RAWTX=tcp://127.0.0.1:28332
MBITE_ZMQ_RAWBLOCK=tcp://127.0.0.1:28333

# Backstop poll interval (ms). Long by design — ZMQ does the fast path.
CONFIRMATION_POLL_MS=60000

# --- Payment policy ---
# Confirmations required before an order is marked PAID (~2min/block).
PAYMENT_CONFIRMATIONS=2
# How long a price quote (and its derived address) stays valid, in seconds.
QUOTE_TTL_SECONDS=900
# Under/overpayment tolerance as a fraction (0.02 = 2%).
PAYMENT_TOLERANCE=0.02
# Platform fee basis points taken via tx-level split (300 = 3%).
PLATFORM_FEE_BPS=300
# Platform fee collection address (watch-only treasury, timelocked vault).
PLATFORM_FEE_ADDRESS=

# --- Web app ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Delivery (signed download URLs) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=moonbite-deliverables
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
SIGNED_URL_TTL_SECONDS=300
