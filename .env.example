# ─────────────────────────────────────────────────────────────
# MoonBite Partners — environment template. Copy to .env and fill.
# NEVER commit the real .env. No private keys live here (see §8 of PLAN.md).
# ─────────────────────────────────────────────────────────────

# --- API server ---
API_PORT=4000
NODE_ENV=development
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# --- Auth (merchant dashboard JWT) ---
# Generate a strong value, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-dev-secret
JWT_EXPIRES_IN=7d
# Public URL of the WEB app — used to build verify/reset links in emails.
WEB_BASE_URL=http://localhost:3000

# --- Rate limiting (per client IP) ---
# Global default: THROTTLE_LIMIT requests per THROTTLE_TTL milliseconds.
# Auth routes override this with tighter per-route limits (see auth.controller.ts).
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
# Set to 1 when the API runs behind a trusted reverse proxy / load balancer so
# the limit keys off X-Forwarded-For (the real client IP), not the proxy IP.
TRUST_PROXY=0

# --- Database (Postgres) ---
DATABASE_URL=postgresql://moonbite:moonbite@localhost:5432/moonbite?schema=public

# --- Redis (invoice state, queues, rate limits) ---
REDIS_URL=redis://localhost:6379

# --- MBITE full node JSON-RPC ---
# Point this at your own node (see docker-compose.yml / PLAN.md Phase 0).
MBITE_RPC_URL=http://127.0.0.1:9332
MBITE_RPC_USER=moonbite
MBITE_RPC_PASSWORD=change-me
# ZMQ endpoints for push notifications (PRIMARY payment trigger — the node must
# be started with -zmqpubrawtx / -zmqpubrawblock). Leave blank to fall back to
# the backstop poller only.
MBITE_ZMQ_RAWTX=tcp://127.0.0.1:28332
MBITE_ZMQ_RAWBLOCK=tcp://127.0.0.1:28333

# Backstop poll interval (ms). Long by design — ZMQ does the fast path.
CONFIRMATION_POLL_MS=60000

# --- Payment policy ---
# Confirmations required before an order is marked PAID (~2min/block).
PAYMENT_CONFIRMATIONS=2
# Confirmations required before a refund tx is accepted (defaults to PAYMENT_CONFIRMATIONS).
REFUND_CONFIRMATIONS=2
# How long a price quote (and its derived address) stays valid, in seconds.
QUOTE_TTL_SECONDS=900
# Under/overpayment tolerance as a fraction (0.02 = 2%).
PAYMENT_TOLERANCE=0.02
# Platform fee basis points taken via tx-level split (300 = 3%).
PLATFORM_FEE_BPS=300
# Platform fee collection address (watch-only treasury, timelocked vault).
PLATFORM_FEE_ADDRESS=

# --- Web app ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Delivery (signed download URLs) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=moonbite-deliverables
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
SIGNED_URL_TTL_SECONDS=300
# Public base URL of THIS api, used to build buyer-facing signed download links
# (e.g. https://api.moonbite.example). The link points at GET /download/:orderId.
PUBLIC_BASE_URL=http://localhost:4000
# Base URL of the object store the signed link ultimately 302-redirects to.
# The real object lives at ${STORAGE_BASE_URL}/<objectKey> (objectKey comes from
# the product's deliveryConfig). No cloud SDK — plain HMAC-signed URLs.
STORAGE_BASE_URL=https://cdn.moonbite.example
# Secret for HMAC-signing signed download URLs. Generate: openssl rand -hex 32
DOWNLOAD_URL_SECRET=change-me-dev-download-secret

# --- Delivery (email receipts) ---
# When SMTP_HOST is set, receipts are sent via nodemailer SMTP; otherwise the
# email is just logged (dev mode). SMTP_PORT 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MoonBite <no-reply@moonbite.example>
