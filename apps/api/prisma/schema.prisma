// MoonBite Partners data model. See PLAN.md §3 / §5 / §6.
// Money is stored as BigInt in the smallest MBITE unit ("satoshi") — never float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MerchantTier {
  STARTER
  VERIFIED
  ELITE
}

enum DeliveryMethod {
  LICENSE_KEY
  SIGNED_DOWNLOAD
  WEBHOOK
  COURSE_ACCESS
}

enum OrderStatus {
  AWAITING_PAYMENT
  DETECTED
  UNDERPAID
  OVERPAID
  PAID
  FULFILLED
  EXPIRED
  REFUNDED
  CANCELLED
}

/// A seller. Non-custodial: we store only their extended PUBLIC key (xpub);
/// we can derive receive addresses but can NEVER spend (see PLAN.md §2 / §8).
model Merchant {
  id            String       @id @default(cuid())
  email         String       @unique
  displayName   String
  /// Public storefront handle (/@handle). Unique, lowercase slug.
  handle        String?      @unique
  /// Storefront profile.
  bio           String?
  avatarUrl     String?
  /// bcrypt hash; null for seeded/demo merchants that have not set a password.
  passwordHash  String?
  /// Email verification + password reset (tokens are sha256 hashes, not raw).
  emailVerified      Boolean   @default(false)
  emailVerifyToken   String?
  emailVerifyExpires DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  tier          MerchantTier @default(STARTER)
  /// BIP32 xpub used to derive a fresh pay-to address per order.
  settlementXpub String?
  /// Next unused derivation index (monotonic; address = xpub/0/index).
  nextKeyIndex  Int          @default(0)
  feeBps        Int          @default(300) // overrides platform default per deal
  createdAt     DateTime     @default(now())
  products      Product[]
  orders        Order[]
  discounts     Discount[]
}

model Product {
  id             String         @id @default(cuid())
  merchant       Merchant       @relation(fields: [merchantId], references: [id])
  merchantId     String
  title          String
  description    String?
  /// Price in the smallest MBITE unit (used when priceCurrency = MBITE).
  priceMbite     BigInt
  /// USD price (authoritative when priceCurrency = USD; converted at checkout).
  displayUsd     Decimal?       @db.Decimal(18, 2)
  /// "MBITE" (native) or "USD" (converted to MBITE at quote time via the oracle).
  priceCurrency  String         @default("MBITE")
  /// Free-text category slug for browse/filter (Phase 2 discovery).
  category       String?
  /// Cover image URL (storefront / product page).
  imageUrl       String?
  /// "Pay what you want": buyer names a price at/above minPriceMbite.
  pwyw           Boolean        @default(false)
  /// Minimum acceptable price for PWYW products, smallest MBITE unit.
  minPriceMbite  BigInt?
  deliveryMethod DeliveryMethod
  /// Method-specific config: webhook URL, storage object key, course id, etc.
  deliveryConfig Json?
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  orders         Order[]
  licenseKeys    LicenseKey[]
  reviews        Review[]
  discounts      Discount[]

  @@index([merchantId])
  @@index([active])
  @@index([category])
}

/// A buyer rating on a fulfilled order (one per order). Phase 2 discovery.
model Review {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  /// One review per order (the order is the proof-of-purchase capability).
  orderId   String   @unique
  rating    Int // 1..5
  comment   String?
  buyerRef  String?
  createdAt DateTime @default(now())

  @@index([productId])
}

/// Pre-uploaded pool of one-time keys for LICENSE_KEY products.
model LicenseKey {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  key       String
  claimedBy String?  // orderId that consumed it
  claimedAt DateTime?

  @@index([productId, claimedBy])
}

model Order {
  id                    String      @id @default(cuid())
  merchant              Merchant    @relation(fields: [merchantId], references: [id])
  merchantId            String
  product               Product     @relation(fields: [productId], references: [id])
  productId             String
  status                OrderStatus @default(AWAITING_PAYMENT)

  /// Freshly derived, unique per order. Watch-only.
  payToAddress          String      @unique
  derivationIndex       Int
  /// Amount owed, locked at quote time, smallest MBITE unit.
  amountMbite           BigInt
  /// Amount actually received (sum of matching tx outputs).
  receivedMbite         BigInt      @default(0)
  requiredConfirmations Int
  confirmations         Int         @default(0)
  /// Platform fee (bps of amount) recorded for reconciliation.
  feeMbite              BigInt      @default(0)

  /// Where to refund if underpaid/cancelled (collected at checkout).
  buyerReturnAddress    String?
  /// Buyer contact for delivery (email or account id).
  buyerRef              String?
  /// Linked buyer account (by email) for the purchase library.
  buyer                 Buyer?      @relation(fields: [buyerId], references: [id])
  buyerId               String?
  /// Discount applied at checkout, if any.
  discountCode          String?
  discountMbite         BigInt      @default(0)

  /// How this order is funded: on-chain MBITE, or a fiat on-ramp (ONRAMP.md).
  paymentRoute          PaymentRoute @default(CRYPTO_NATIVE)
  /// On-ramp provider reference (unique) used to settle a FIAT_ONRAMP order.
  onrampProviderRef     String?     @unique
  fiatAmount            Decimal?    @db.Decimal(18, 2)
  fiatCurrency          String?

  txid                  String?
  quoteExpiresAt        DateTime
  paidAt                DateTime?
  fulfilledAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  entitlement           Entitlement?
  refund                Refund?

  @@index([status])
  @@index([merchantId])
  @@index([payToAddress])
  @@index([buyerId])
}

enum PaymentRoute {
  CRYPTO_NATIVE
  FIAT_ONRAMP
}

/// A locked fiat→MBITE price quote (ONRAMP.md §3). Consumed when a fiat
/// on-ramp session/order is created.
model Quote {
  id            String   @id @default(cuid())
  productId     String
  /// Base MBITE the buyer is purchasing (post PWYW/discount), smallest unit.
  mbiteAmount   BigInt
  fiatCurrency  String   @default("USD")
  /// Buyer-facing fiat charge, including spread.
  fiatAmount    Decimal  @db.Decimal(18, 2)
  spreadBps     Int
  mbitePerUsd   Decimal  @db.Decimal(24, 8)
  status        String   @default("PENDING") // PENDING | USED | EXPIRED
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([status])
}

/// A buyer account — the purchase "Library". Linked to orders by email.
model Buyer {
  id           String   @id @default(cuid())
  email        String   @unique
  /// null for guest buyers (checkout by email); set when they register.
  passwordHash String?
  createdAt    DateTime @default(now())
  orders       Order[]
}

/// A merchant discount / coupon code. percentOff XOR amountOffMbite.
model Discount {
  id             String    @id @default(cuid())
  merchant       Merchant  @relation(fields: [merchantId], references: [id])
  merchantId     String
  code           String
  /// Percent off (1..100), when set. Otherwise a fixed amount off.
  percentOff     Int?
  /// Fixed amount off, smallest MBITE unit, when set.
  amountOffMbite BigInt?
  /// Scope to one product, or null for all of the merchant's products.
  product        Product?  @relation(fields: [productId], references: [id])
  productId      String?
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@unique([merchantId, code])
  @@index([merchantId])
}

/// What the buyer actually receives once PAID → FULFILLED.
model Entitlement {
  id          String    @id @default(cuid())
  order       Order     @relation(fields: [orderId], references: [id])
  orderId     String    @unique
  /// e.g. the issued license key, or storage object key for signed URLs.
  payload     Json
  deliveredAt DateTime  @default(now())
  /// Set when a confirmed refund revokes access (PLAN.md §4).
  revokedAt   DateTime?
}

enum RefundStatus {
  /// A refund was asked for; merchant has not yet sent funds.
  REQUESTED
  /// Merchant broadcast a refund tx and recorded its id; awaiting on-chain proof.
  SUBMITTED
  /// Refund tx verified on-chain (pays the return address, enough confs). Terminal.
  CONFIRMED
  /// Merchant declined the request. Terminal.
  REJECTED
}

/// Non-custodial refund record. The platform never moves funds — the merchant
/// sends MBITE back from their own wallet and records the txid here; the
/// platform verifies it on-chain and then flips the order to REFUNDED.
model Refund {
  id            String       @id @default(cuid())
  order         Order        @relation(fields: [orderId], references: [id])
  orderId       String       @unique
  status        RefundStatus @default(REQUESTED)
  reason        String?
  /// Address the refund must pay (defaults to order.buyerReturnAddress).
  refundAddress String
  /// Amount to return, smallest MBITE unit (defaults to amount received).
  amountMbite   BigInt
  /// The merchant-broadcast refund tx, recorded by the merchant.
  txid          String?
  confirmations Int          @default(0)
  requestedAt   DateTime     @default(now())
  submittedAt   DateTime?
  confirmedAt   DateTime?
  rejectedAt    DateTime?
  updatedAt     DateTime     @updatedAt

  @@index([status])
}
